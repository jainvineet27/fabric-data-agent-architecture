# Option A: Direct SQLAlchemy Connection String URL (PostgreSQL or SQL Server)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/postgres
# DATABASE_URL=mssql+pyodbc://sa:your_password@localhost:1433/MySampleDB?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# Option B: Individual SSMS (SQL Server) Connection Details
SQL_SERVER_NAME=localhost\SQLEXPRESS
SQL_DATABASE_NAME=MySampleDB
USE_WINDOWS_AUTH=true
SQL_USERNAME=sa
SQL_PASSWORD=your_password

# Microsoft Fabric Published Data Agent Details
FABRIC_WORKSPACE_ID=your-workspace-id
FABRIC_DATA_AGENT_ID=your-data-agent-id

